{
  "name": "shizuha",
  "version": "0.1.0",
  "description": "Shizuha universal coding agent",
  "type": "module",
  "main": "dist/shizuha.js",
  "bin": {
    "shizuha": "dist/shizuha.js"
  },
  "scripts": {
    "build": "node esbuild.config.js && vite build --config vite.web.config.ts",
    "postbuild": "chmod +x dist/shizuha.js",
    "build:node": "node esbuild.config.js",
    "build:web": "vite build --config vite.web.config.ts",
    "build:public": "node esbuild.config.js --no-claude-code-provider && chmod +x dist/shizuha.js",
    "build:check": "tsc --noEmit",
    "sync-skills": "node scripts/sync-skills.mjs",
    "dev": "tsx src/index.ts",
    "dev:web": "vite --config vite.web.config.ts",
    "dev:tauri": "vite --config vite.tauri.config.ts",
    "build:tauri": "vite build --config vite.tauri.config.ts",
    "tauri": "tauri",
    "test": "vitest run",
    "test:tui:ci": "vitest run tests/tui/session.test.ts tests/tui/turn-permission.test.ts tests/tui/tool-visibility.test.ts tests/tui/tool-input-preview.test.ts tests/tui/text-edit.test.ts tests/tui/slash-commands.test.ts tests/tui/rate-limit.test.ts tests/tui/status-config.test.ts tests/tui/state-store-sessions.test.ts tests/tui/types.test.ts tests/tui/osc8.test.ts tests/tui/terminal.test.ts tests/tui/ask-user-callback.test.ts tests/tui/mode-cycle-key.test.ts tests/tui/resume-transcript.test.ts",
    "test:perf": "vitest run tests/perf/",
    "bench:tui-input": "tsx scripts/bench-tui-input-latency.ts",
    "perf:update-baseline": "vitest run tests/perf/ --reporter=verbose && node scripts/update-perf-baseline.mjs",
    "ci": "node scripts/ci/full-ci.mjs",
    "ci:fast": "node scripts/ci/full-ci.mjs",
    "test:e2e:long": "node scripts/ci/cortex-long-e2e.mjs",
    "test:watch": "vitest",
    "serve": "tsx src/server.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^10.1.3",
    "@google/generative-ai": "^0.24.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^11.8.0",
    "chalk": "^5.6.2",
    "commander": "^13.1.0",
    "diff": "^8.0.4",
    "dompurify": "^3.4.13",
    "fastify": "^5.8.5",
    "glob": "^11.0.0",
    "ink": "^6.8.0",
    "jose": "^5.9.6",
    "marked": "^14.1.4",
    "marked-terminal": "^7.3.0",
    "openai": "^4.80.0",
    "pdf-parse": "^1.1.4",
    "pino": "^9.6.0",
    "playwright": "^1.58.2",
    "prom-client": "^15.1.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "smol-toml": "^1.6.1",
    "sqlite-vec": "^0.1.7-alpha.2",
    "tiktoken": "^1.0.0",
    "turndown": "^7.2.0",
    "wrap-ansi": "9.0.2",
    "ws": "^8.19.0",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.2.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.0",
    "@types/diff": "^7.0.2",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.0",
    "@vitejs/plugin-react": "^5.1.4",
    "esbuild": "^0.25.0",
    "fast-xml-parser": "^5.10.1",
    "javascript-obfuscator": "^5.3.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "license": "AGPL-3.0-or-later",
  "overrides": {
    "express-rate-limit": "8.6.2",
    "body-parser": "2.3.0",
    "fast-uri": "3.1.5",
    "@babel/core": "7.29.7",
    "picomatch": "4.0.5",
    "postcss": "8.5.25"
  }
}
