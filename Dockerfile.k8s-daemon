# Multi-stage build for the k3s-mode fleet daemon image (P2c).
# Builds `dist` from src INSIDE the image (stage 1) so it NEVER touches the live
# host dist that the running rt-fleet docker daemon mounts. Runtime stage reuses the
# agent-runtime base (node22 + the bridge CLIs) and bakes the freshly-built dist.
# Build (isolated, from git@HEAD which has the k8s backend):
#   kaniko --context=git://github.com/shizuha-labs/shizuha-beta.git#<sha> \
#          --dockerfile=Dockerfile.k8s-daemon \
#          --destination=<reg>/shizuha-agent-runtime:k8sdaemon-<sha>
# The same image runs BOTH a k3s agent (entrypoint passes claude-bridge/codex-bridge)
# AND the k3s daemon (pass `up --foreground --no-service`).

# ---- stage 1: build dist ----
FROM node:22 AS build
WORKDIR /src
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN node esbuild.config.js --no-claude-code-provider && chmod +x dist/shizuha.js

# ---- stage 2: runtime (mirror Dockerfile.agent-runtime, dist from stage 1) ----
FROM ubuntu:24.04
ENV NODE_MAJOR=22 DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl gnupg git python3 \
      sudo lsb-release software-properties-common tini \
  && install -m 0755 -d /etc/apt/keyrings \
  && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
  && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_MAJOR}.x nodistro main" > /etc/apt/sources.list.d/nodesource.list \
  && apt-get update && apt-get install -y --no-install-recommends nodejs gh \
  && rm -rf /var/lib/apt/lists/*
RUN npm install -g @anthropic-ai/claude-code @openai/codex@0.144.0 openclaw || true \
 && curl -fsSL https://antigravity.google/cli/install.sh | bash -s -- --dir /usr/local/bin \
 && ln -sfn /usr/local/bin/agy /usr/local/bin/antigravity || true
RUN useradd -m -u 1000 -s /bin/bash agent || true
WORKDIR /opt/shizuha
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund
COPY --from=build /src/dist ./dist
COPY agent-runtime-entrypoint.sh /usr/local/bin/agent-runtime-entrypoint.sh
RUN chmod +x /usr/local/bin/agent-runtime-entrypoint.sh
WORKDIR /home/agent
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/agent-runtime-entrypoint.sh"]
